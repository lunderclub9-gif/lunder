# LUNDER'S 3D STUDIO — configuration du client Supabase.
# Copiez ce fichier en `.env` puis renseignez les valeurs de votre projet.
# Ces variables sont PUBLIQUES (exposées au navigateur) : n'y mettez jamais
# de clé `service_role`, de secret d'API ou de mot de passe.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog (analytics) — facultatif : sans ces deux valeurs, aucun événement
# n'est envoyé et l'application fonctionne normalement.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
