{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/boutique/sur-mesure",
      "destination": "/boutique/sur-mesure.html"
    },
    {
      "source": "/boutique/informations",
      "destination": "/boutique/informations.html"
    },
    {
      "source": "/boutique/produits",
      "destination": "/boutique/produits.html"
    },
    {
      "source": "/boutique/produits/:slug",
      "destination": "/boutique/produits/:slug.html"
    },
    {
      "source": "/boutique/categories/:slug",
      "destination": "/boutique/categories/:slug.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
